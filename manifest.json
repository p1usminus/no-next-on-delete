{
  "manifest_version": 2,
  "name": "No Next Message on Delete",
  "version": "1.7.0",
  "description": "Deletes selected messages without selecting the next message.",
  "browser_specific_settings": {
    "gecko": {
      "id": "no-next-on-delete@example.local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "messagesRead",
    "messagesDelete",
    "accountsRead"
  ],
  "icons": {
    "16": "icons/delete-16.png",
    "32": "icons/delete-32.png",
    "64": "icons/delete-64.png"
  },
  "browser_action": {
    "default_title": "Delete without opening next message",
    "default_label": "Delete",
    "default_icon": {
      "16": "icons/delete-16.png",
      "32": "icons/delete-32.png"
    }
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Delete",
        "mac": "Command+Delete"
      },
      "description": "Delete without opening next message"
    }
  }
}
